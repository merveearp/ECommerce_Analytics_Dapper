@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="dashboard-ecommerce">
    <div class="container-fluid dashboard-content">

       
        <div class="row mb-4">
            <div class="col-12">
                <div class="page-header">
                    <h2 class="pageheader-title">E-Commerce | Dashboard</h2>
                    <p class="pageheader-text">
                        Satış, müşteri ve gelir metriklerinin genel görünümü
                    </p>
                </div>
            </div>
        </div>

       
        <div class="row">

            @await Component.InvokeAsync("_UIWidget1Component")
            @await Component.InvokeAsync("_UIWidget2Component")

            <!-- Revenue -->
            <div class="col-xl-3 col-lg-6 col-md-6 col-sm-12 mb-4">
                <div class="card h-100">
                    <div class="card-body">
                        <h5 class="text-muted">Revenue</h5>

                        <div class="d-flex justify-content-between align-items-center">
                            <h1 class="mb-0 text-primary">$5,656</h1>
                            <span class="text-danger fw-bold">
                                <i class="fa fa-caret-down"></i> 7%
                            </span>
                        </div>
                    </div>
                    <div id="sparkline-3"></div>
                </div>
            </div>

            <!-- Growth -->
            <div class="col-xl-3 col-lg-6 col-md-6 col-sm-12 mb-4">
                <div class="card h-100">
                    <div class="card-body">
                        <h5 class="text-muted">Growth</h5>

                        <div class="d-flex justify-content-between align-items-center">
                            <h1 class="mb-0 text-primary">28.45%</h1>
                            <span class="text-success fw-bold">
                                <i class="fa fa-caret-up"></i> 4.87%
                            </span>
                        </div>
                    </div>
                    <div id="sparkline-4"></div>
                </div>
            </div>





        </div>
        
        <div class="row">

            <div class="col-xl-5 col-lg-3 col-md-6 col-sm-12">
                @await Component.InvokeAsync("_UIDoughnetChart1Component")
            </div>

            <div class="col-xl-7 col-lg-3 col-md-6 col-sm-12">
                @await Component.InvokeAsync("_UIBar1Component")
            </div>
        </div>

           <br /> 
          
        <div class="row">



            <div class="col-xl-5 col-lg-3 col-md-6 col-sm-12">
                @await Component.InvokeAsync("_UITable1Component")
            </div>

            <div class="col-xl-7 col-lg-3 col-md-6 col-sm-12">
              
                @await Component.InvokeAsync("_UILine1Component")
              

            </div>
          

        </div>
           

        <br />


        <div class="row">
           
            <div class="col-xl-3 col-lg-12 col-md-3 col-sm-12 col-12">
                @await Component.InvokeAsync("_UIProfit1Component")

            </div>
            <!-- recent orders  -->
          
            <div class="col-xl-9 col-lg-12 col-md-6 col-sm-12 col-12">
                @await Component.InvokeAsync("_UITable2Component")

            </div>
        
            <!-- end recent orders  -->
          
        </div>



    </div>
</div>



















