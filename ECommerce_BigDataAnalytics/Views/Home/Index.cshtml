@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="dashboard-ecommerce">
    <div class="container-fluid dashboard-content">

       
        <div class="row mb-4">
            <div class="col-12">
                <div class="page-header">
                    <h2 class="pageheader-title">E-Commerce | Dashboard</h2>
                    <p class="pageheader-text">
                        Satış, müşteri ve gelir metriklerinin genel görünümü
                    </p>
                </div>
            </div>
        </div>

       
        <div class="row">

            @await Component.InvokeAsync("_UIWidget1Component")
            @await Component.InvokeAsync("_UIWidget2Component")

            <!-- Revenue -->
            <div class="col-xl-3 col-lg-6 col-md-6 col-sm-12 mb-4">
                <div class="card h-100">
                    <div class="card-body">
                        <h5 class="text-muted">Revenue</h5>

                        <div class="d-flex justify-content-between align-items-center">
                            <h1 class="mb-0 text-primary">$5,656</h1>
                            <span class="text-danger fw-bold">
                                <i class="fa fa-caret-down"></i> 7%
                            </span>
                        </div>
                    </div>
                    <div id="sparkline-3"></div>
                </div>
            </div>

            <!-- Growth -->
            <div class="col-xl-3 col-lg-6 col-md-6 col-sm-12 mb-4">
                <div class="card h-100">
                    <div class="card-body">
                        <h5 class="text-muted">Growth</h5>

                        <div class="d-flex justify-content-between align-items-center">
                            <h1 class="mb-0 text-primary">28.45%</h1>
                            <span class="text-success fw-bold">
                                <i class="fa fa-caret-up"></i> 4.87%
                            </span>
                        </div>
                    </div>
                    <div id="sparkline-4"></div>
                </div>
            </div>





        </div>
        
        <div class="row">
           
            @await Component.InvokeAsync("_UIPolarChart1Component")

            @await Component.InvokeAsync("_UIMultiLine1Component")

           
        </div>

        <br />

        <div class="row mb-3">
            <div class="col-12">
                <h4 class="mb-1 fw-bold">Ödeme Tiplerine Göre Ciro Dağılımı</h4>
                <p class="text-muted mb-0">
                    Son 1 ay içerisinde ödeme tiplerine göre gerçekleşen toplam ciro dağılımı gösterilmektedir.
                    Aşağıdaki kartlar, ilgili ödeme yöntemleri üzerinden elde edilen toplam tutarları özetlemektedir.
                </p>
            </div>
        </div>

        <div class="row">
            @await Component.InvokeAsync("_UIPaymentWidgetsComponent")
        </div>



        <div class="row">
           @*  @await Component.InvokeAsync("_UIPieChart1Component") *@
           
        </div>

    </div>
</div>



















