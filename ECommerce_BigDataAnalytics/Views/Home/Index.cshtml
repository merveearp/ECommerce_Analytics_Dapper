@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="dashboard-ecommerce">
    <div class="container-fluid dashboard-content">

       
        <div class="row mb-4">
            <div class="col-12">
                <div class="page-header">
                    <h2 class="pageheader-title">E-Commerce | Dashboard</h2>
                    <p class="pageheader-text">
                        Satış, müşteri ve gelir metriklerinin genel görünümü
                    </p>
                </div>
            </div>
        </div>

       
        <div class="row">


            <div class="col-xl-3 col-lg-6 col-md-6 col-sm-12 col-12">

                @await Component.InvokeAsync("_UIWidget1Component")

            </div>

            <div class="col-xl-3 col-lg-6 col-md-6 col-sm-12 col-12">

                @await Component.InvokeAsync("_UIWidget2ComponentV1")

            </div>


           
           
            <div class="col-xl-3 col-lg-6 col-md-6 col-sm-12 mb-4">
                @await Component.InvokeAsync("_UIWidget3Component")
            </div>



            <div class="col-xl-3 col-lg-6 col-md-6 col-sm-12 mb-4">
                @await Component.InvokeAsync("_UIWidget4Component")
            </div>

            
      


        </div>

        <br />
        <br />

        
        <div class="row">

            <div class="col-xl-5 col-lg-3 col-md-6 col-sm-12">
                @await Component.InvokeAsync("_UIDoughnetChart1Component")
            </div>

            <div class="col-xl-7 col-lg-3 col-md-6 col-sm-12">
                @await Component.InvokeAsync("_UIBar1Component")
            </div>
        </div>

           <br /> 
          
        <div class="row">



            <div class="col-xl-5 col-lg-3 col-md-6 col-sm-12">
                @await Component.InvokeAsync("_UITable1Component")
            </div>

            <div class="col-xl-7 col-lg-3 col-md-6 col-sm-12">
              
                @await Component.InvokeAsync("_UILine1Component")
              

            </div>
          

        </div>
           

        <br />

        <div class="row g-3">

            <div class="col-xl-3 col-lg-4 col-md-12">

                <div class="mb-3">
                    @await Component.InvokeAsync("_UIProfit1Component")
                </div>

                <div>
                    @await Component.InvokeAsync("_UIWidget2Component")
                </div>

            </div>

          
            <div class="col-xl-9 col-lg-8 col-md-12">
                @await Component.InvokeAsync("_UITable2Component")
            </div>

        </div>



        <br /><br />

        <div class="row">
           
            <div class="col-xl-6 col-lg-12 col-md-3 col-sm-12 col-12">
                @await Component.InvokeAsync("_UIStockTableComponent")

            </div>
       
          
            <div class="col-xl-6 col-lg-12 col-md-6 col-sm-12 col-12">
                @await Component.InvokeAsync("_UILowStockComponent")
              

            </div>
        
        </div>

        <br />
        <br />

        <div class="row">
           
            <div class="col-xl-5 col-lg-12 col-md-3 col-sm-12 col-12">
                @await Component.InvokeAsync("_UIDoughnetChart2Component")

            </div>
           
            <div class="col-xl-7 col-lg-12 col-md-6 col-sm-12 col-12">
                @await Component.InvokeAsync("_UIBar4Component")
              

            </div>
        
        </div>



    </div>
</div>



















