@{
    ViewData["Title"] = "Dashboard1";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="dashboard-ecommerce">
    <div class="container-fluid dashboard-content">


        <div class="row mb-3">
            <div class="col-12">
                <h4 class="mb-1 fw-bold">Ödeme Tiplerine Göre Ciro Dağılımı</h4>
                <p class="text-muted mb-0">
                    Son 1 ay içerisinde ödeme tiplerine göre gerçekleşen toplam ciro dağılımı gösterilmektedir.
                    Aşağıdaki kartlar, ilgili ödeme yöntemleri üzerinden elde edilen toplam tutarları özetlemektedir.
                </p>
            </div>
        </div>


            @await Component.InvokeAsync("_UIPaymentWidgetsComponent")


        <div class="row mt-4">

            <!-- SOL: 2024 -->
            <div class="col-6">

                <div class="bg-white p-3 rounded shadow-sm mb-3">
                    <h5 class="fw-bold mb-1">
                        📊 2024 Yılı Satış Dağılım Analizi
                    </h5>
                    <p class="text-muted mb-0 small">
                        2024 yılına ait aylık satış performansı
                    </p>
                </div>

                <div class="mb-3">
                    @await Component.InvokeAsync("_UILine2ComponentV1")
                </div>

                <div>
                    @await Component.InvokeAsync("_UILine3ComponentV1")
                </div>

            </div>


            <!-- SAĞ: 2025 -->
            <div class="col-6">

                <div class="bg-white p-3 rounded shadow-sm mb-3">
                    <h5 class="fw-bold mb-1">
                        📊 2025 Yılı Satış Dağılım Analizi
                    </h5>
                    <p class="text-muted mb-0 small">
                        2025 yılına ait aylık satış performansı
                    </p>
                </div>

                <div class="mb-3">
                    @await Component.InvokeAsync("_UILine2Component")
                </div>

                <div>
                    @await Component.InvokeAsync("_UILine3Component")
                </div>

            </div>

        </div>


        <div class="row g-4">


            <div class="col-xl-5 col-lg-5 col-md-12">

                @await Component.InvokeAsync("_UIDashboard1Table3Component")

            </div>

            <div class="col-xl-7 col-lg-7 col-md-12">

                @await Component.InvokeAsync("_UIPieChart1Component")
               

            </div>

        </div>

        <div class="row g-4">


            <div class="col-xl-7 col-lg-5 col-md-12">

                @await Component.InvokeAsync("_UIDashboard1Bar2Component")

            </div> 

            <div class="col-xl-5 col-lg-7 col-md-12">

         @await Component.InvokeAsync("_UIDashboard1LowProductComponent")


            </div>

        </div>

        <br />

        <div class="row g-4">


            <div class="col-xl-6 col-lg-5 col-md-12">

                @await Component.InvokeAsync("_UIDashboard1Table4Component")
                @await Component.InvokeAsync("_UIDashboard1Line4Component")

            </div> 

            <div class="col-xl-6 col-lg-7 col-md-12">

              
                @await Component.InvokeAsync("_UIDashboard1Bar3Component")


            </div>

        </div>


    </div>
</div>



















