@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="dashboard-ecommerce">
    <div class="container-fluid dashboard-content">


        <div class="row mb-3">
            <div class="col-12">
                <h4 class="mb-1 fw-bold">Ödeme Tiplerine Göre Ciro Dağılımı</h4>
                <p class="text-muted mb-0">
                    Son 1 ay içerisinde ödeme tiplerine göre gerçekleşen toplam ciro dağılımı gösterilmektedir.
                    Aşağıdaki kartlar, ilgili ödeme yöntemleri üzerinden elde edilen toplam tutarları özetlemektedir.
                </p>
            </div>
        </div>

        <div class="row">
            @await Component.InvokeAsync("_UIPaymentWidgetsComponent")
        </div>



        <div class="row mt-4">

            <div class="col-12 mb-3">
                <div class="bg-white p-3 rounded shadow-sm">
                    <h5 class="fw-bold mb-1">
                        📊 2025 Yılı Satış Dağılım Analizi
                    </h5>
                    <p class="text-muted mb-0 small">
                        2025 yılına ait aylık satış performansı ve dağılım grafikleri
                    </p>
                </div>
            </div>

            @await Component.InvokeAsync("_UILine2Component")

            @await Component.InvokeAsync("_UILine3Component")

        </div>

        <div class="row g-4">


            <div class="col-xl-5 col-lg-5 col-md-12">

                @await Component.InvokeAsync("_UIDashboard1Table3Component")

            </div>

            <div class="col-xl-7 col-lg-7 col-md-12">

                @await Component.InvokeAsync("_UIPieChart1Component")
               

            </div>

        </div>

        <div class="row g-4">


            <div class="col-xl-4 col-lg-5 col-md-12">

                @await Component.InvokeAsync("_UIDashboard1Bar2Component")

            </div>

            <div class="col-xl-4 col-lg-7 col-md-12">

               

            </div>

        </div>


    </div>
</div>



















