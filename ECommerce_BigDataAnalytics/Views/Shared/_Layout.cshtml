
<!doctype html>
<html lang="en">

<body>

 @await Component.InvokeAsync("_LayoutHeadComponent")
    <!-- main wrapper -->

    <div class="dashboard-main-wrapper">

        <div class="dashboard-header">

@await Component.InvokeAsync("_LayoutNavbarComponent")

        </div>       

@await Component.InvokeAsync("_LayoutSidebarComponent")             
       
        <div class="dashboard-wrapper">
           
        @RenderBody()


@await Component.InvokeAsync("_LayoutFooterComponent")
           
        </div>               
    </div>
    
 @await Component.InvokeAsync("_LayoutScriptsComponent")

</body>

</html>