@model List<DoughnutChart1Dto>


    <div class="card h-100">
        <h5 class="card-header">Sipariş Durum & Sipariş Sayısı</h5>
        <div class="card-body d-flex justify-content-center align-items-center">
            <canvas id="orderPolarChart" style="max-height:300px;"></canvas>
        </div>
    </div>


<script>

    document.addEventListener("DOMContentLoaded", function () {

        const ctx = document.getElementById('orderPolarChart');
        if (!ctx) return;

        const labels = [
            @foreach (var item in Model)
            {
                    <text>'@Html.Raw(item.StatusName)',</text>
            }
        ];

        const data = [
            @foreach (var item in Model)
            {
                    <text>@item.OrderCount,</text>
            }
        ];

        const colors = [
            '#39C4E3',
            '#BD1C0D',
            '#59DE5B',
            '#D9E339',
            '#FFB74D'
        ];

           const centerTextPlugin = {
        id: 'centerText',
        beforeDraw(chart) {
            const { ctx } = chart;

            const meta = chart.getDatasetMeta(0);
            if (!meta || !meta.data || !meta.data.length) return;

            const centerX = meta.data[0].x;
            const centerY = meta.data[0].y;

            const total = '@ViewBag.Total';

            ctx.save();

            ctx.textAlign = "center";
            ctx.textBaseline = "middle";

            
            ctx.font = "bold 30px Arial";
            ctx.fillStyle = "#333";
            ctx.fillText(total, centerX, centerY - 8);

           
            ctx.font = "14px Arial";
            ctx.fillStyle = "#777";
            ctx.fillText("Toplam Sipariş", centerX, centerY + 18);

            ctx.restore();
        }
    };

        new Chart(ctx, {
            type: 'doughnut',
            data: {
                labels: labels,
                datasets: [{
                    data: data,
                    backgroundColor: colors.slice(0, data.length),
                    borderColor: '#fff',
                    borderWidth: 2
                }]
            },
            options: {
                cutout: '70%',
                plugins: {
                    legend: {
                        position: 'right'
                    }
                }
            },
            plugins: [centerTextPlugin]
        });

    });
</script>