@using ECommerce_BigDataAnalytics.Dtos.TableDto
@model List<PieChartCategoryDto>

@{
    int count = 0;
    int maxProduct = Model.Max(x => x.ProductCount);
}

<div class="card shadow-sm border-0 rounded-3">

    <div class="card-header bg-white border-0 py-3 d-flex justify-content-between align-items-center">
        <div>
            <h5 class="fw-bold mb-0 text-primary">
                ⭐ Top 10 Kategori
            </h5>
            <small class="text-muted">
                En çok ürüne sahip kategoriler
            </small>
        </div>
        <span class="badge bg-warning text-dark">
            TOP 10
        </span>
    </div>

    <div class="card-body p-0">

        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0">

                <thead class="table-light">
                    <tr>
                        <th style="width:60px">#</th>
                        <th>Kategori</th>
                        <th style="width:140px">Ürün</th>
                        <th style="width:220px">Dağılım</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        count++;
                        var percent = (item.ProductCount * 100) / maxProduct;

                        <tr>

                            <td class="fw-semibold">

                                @if (count == 1)
                                {
                                    <span class="text-warning">
                                        🥇
                                    </span>
                                }
                                else if (count == 2)
                                {
                                    <span class="text-secondary">
                                        🥈
                                    </span>
                                }
                                else if (count == 3)
                                {
                                    <span style="color:#cd7f32">
                                        🥉
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">
                                        @count
                                    </span>
                                }

                            </td>

                            <td>
                                <span class="fw-semibold">
                                    @item.CategoryName
                                </span>
                            </td>

                            <td>
                                <span class="badge bg-primary">
                                    @item.ProductCount
                                </span>
                            </td>

                            <td>

                                <div class="progress" style="height:8px;">
                                    <div class="progress-bar bg-success"
                                         style="width:@percent%">
                                    </div>
                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>