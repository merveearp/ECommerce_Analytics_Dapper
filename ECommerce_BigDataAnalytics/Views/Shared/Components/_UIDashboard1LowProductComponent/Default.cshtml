@using ECommerce_BigDataAnalytics.Dtos.TableDto
@model List<TopProductsDto>

<div class="card shadow-sm border-0 h-100">

    <div class="card-header bg-light d-flex align-items-center justify-content-between">

        <h5 class="mb-0 fw-semibold">
            <i class="bi bi-box-seam text-primary me-2"></i>
            Satış Almayan Ürünler
        </h5>

    </div>

    <div class="card-body p-0">

        <div class="table-responsive">

            <table class="table align-middle mb-0">

                <thead class="small text-muted border-bottom">
                    <tr>
                        <th style="width:40px">#</th>

                        <th>
                            <i class="bi bi-box me-1 text-primary"></i>
                            Ürün
                        </th>

                        <th class="text-center">
                            <i class="bi bi-archive me-1 text-success"></i>
                            Stok
                        </th>

                        <th style="width:45%">
                            <i class="bi bi-bar-chart me-1 text-warning"></i>
                            Stok Yoğunluğu
                        </th>
                    </tr>
                </thead>

                <tbody>

                    @{
                        int count = 0;
                        var maxStock = Model.Any() ? Model.Max(x => x.StockQuantity) : 1;
                    }

                    @foreach (var item in Model)
                    {
                        count++;

                        int percent = (int)((item.StockQuantity * 100.0) / maxStock);

                        <tr>

                            <td class="text-muted">@count</td>

                            <td>
                                <div class="fw-semibold">@item.ProductName</div>
                                <small class="text-muted">@item.CategoryName</small>
                            </td>

                            <td class="text-center">

                                @if (item.StockQuantity > 200)
                                {
                                    <span class="badge bg-danger-subtle text-danger">
                                        @item.StockQuantity
                                    </span>
                                }
                                else if (item.StockQuantity > 100)
                                {
                                    <span class="badge bg-warning-subtle text-warning">
                                        @item.StockQuantity
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-success-subtle text-success">
                                        @item.StockQuantity
                                    </span>
                                }

                            </td>

                            <td>

                                <div class="progress" style="height:8px">

                                    <div class="progress-bar bg-primary"
                                         role="progressbar"
                                         style="width:@percent%">
                                    </div>

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>