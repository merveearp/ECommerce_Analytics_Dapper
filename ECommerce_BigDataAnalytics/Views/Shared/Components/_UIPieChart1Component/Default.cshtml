@model List<PieChartCategoryDto>
@*
    _UIPieChart1Component
*@


<div class="col-xl-6 col-lg-6 col-md-6 col-sm-12 col-12">
    <div class="card">
        <h5 class="card-header">Kategorilere Göre Ürün Dağılımı </h5>
        <div class="card-body">
            <canvas id="categoryChart"></canvas>
        </div>
    </div>
</div>



<script>
    const labels = [
        @foreach (var item in Model)
        {
                <text>'@item.CategoryName',</text>
        }
    ];

    const data = [
        @foreach (var item in Model)
        {
                <text>@item.ProductCount,</text>
        }
    ];

                 
         const colors = [
        '#2C3E50',  
        '#34495E',  
        '#7F8C8D',  
        '#95A5A6',  
        '#BDC3C7',  
        '#ECF0F1',  
        '#16A085',  
        '#27AE60',  
        '#2980B9',  
        '#8E44AD',  
        '#E74C3C',  
        '#F39C12',  
        '#D35400'   
    ];

        new Chart(document.getElementById('categoryChart'), {
            type: 'pie',
            data: {
                labels: labels,
                datasets: [{
                    label: 'Kategori Bazlı Ürün Sayısı',
                    data: data,
                    backgroundColor: colors.slice(0, data.length),
                    borderWidth: 1
                }]
            }
        });
</script>
