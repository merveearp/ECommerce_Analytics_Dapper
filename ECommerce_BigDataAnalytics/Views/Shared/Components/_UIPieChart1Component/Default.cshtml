@model List<PieChartCategoryDto>
@*
    _UIPieChart1Component
*@



    <div class="card">
        <h5 class="card-header">Kategorilere Göre Ürün Dağılımı </h5>
        <div class="card-body" style="height:600px;">
            <canvas id="categoryChart"></canvas>
        </div>
    </div>




<script>
    const labels = [
        @foreach (var item in Model)
        {
                <text>'@item.CategoryName',</text>
        }
    ];

    const data = [
        @foreach (var item in Model)
        {
                <text>@item.ProductCount,</text>
        }
    ];

                 
         const colors = [
        '#CBF5F2',
        '#78B3AE',
        '#83C3C9',
        '#92DECE',
        '#2B9BA1',
        '#39E3C0',
        '#057AA1',
        '#41869C',
        '#C3D7DB',
        '#0D4E63',
        '#90D6D2',
        '#46889E',
        '#051E26',
        '#D3ECF2'
    ];

           new Chart(document.getElementById('categoryChart'), {
        type: 'pie',
        data: {
            labels: labels,
            datasets: [{
                label: 'Kategori Bazlı Ürün Sayısı',
                data: data,
                backgroundColor: colors.slice(0, data.length),
                borderWidth: 1
            }]
        },
        options: {

            plugins: {

                legend: {
                    position: 'right',  
                    labels: {
                        boxWidth: 15,
                        padding: 15
                    }
                }

            }

        }
    });
</script>
