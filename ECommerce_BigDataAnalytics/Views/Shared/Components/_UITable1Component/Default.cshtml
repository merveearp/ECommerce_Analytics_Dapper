@model List<DoughnutChart1Dto>

<div class="table-responsive mt-3">
    <table class="table table-sm align-middle text-center">
        <thead class="bg-light">
            <tr>
                <th class="text-start">
                    <i class="bi bi-clipboard-data me-1 text-primary"></i>
                    Sipariş Durumu
                </th>
                <th>
                    <i class="bi bi-box-seam me-1 text-success"></i>
                    Adet
                </th>
                <th>
                    <i class="bi bi-percent me-1 text-warning"></i>
                    Oran
                </th>
            </tr>
        </thead>
        <tbody>

            @foreach (var item in Model)
            {
                var percentage = ViewBag.Total > 0
                ? ((double)item.OrderCount / ViewBag.Total * 100).ToString("0.0")
                : "0";

                <tr class="table-row-hover">
                    <td class="text-start fw-semibold">
                        <i class="bi bi-circle-fill text-secondary me-2"
                           style="font-size:8px;"></i>
                        @item.StatusName
                    </td>
                    <td class="fw-bold text-dark">
                        @item.OrderCount.ToString("N0")
                    </td>
                    <td class="text-muted">
                        @percentage %
                    </td>
                </tr>
            }

            <tr class="fw-bold border-top">
                <td class="text-start">
                    <i class="bi bi-calculator me-1 text-dark"></i>
                    Toplam
                </td>
                <td>@ViewBag.Total.ToString("N0")</td>
                <td>100 %</td>
            </tr>

        </tbody>
    </table>
</div>