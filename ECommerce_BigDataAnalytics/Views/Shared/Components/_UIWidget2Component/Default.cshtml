
@*
    _UIWidget1Component
*@



    <div class="card">
        <div class="card-body">
            <div class="d-flex align-items-center justify-content-between">

               
                <div class="d-flex align-items-center">
                    <div>
                        <h4 class="text-muted mb-0">Sipariş Değerleri</h4>
                        <small class="text-muted">Son 30 Günlük Değer Grafiği </small>
                    </div>
                </div>

                
                <span class="badge
            @(ViewBag.ChangeRate >= 0 ? "badge-success" : "badge-danger")
            fs-6">
                    <i class="fa @(ViewBag.ChangeRate >= 0 ? "fa-arrow-up" : "fa-arrow-down")"></i>
                    @(ViewBag.ChangeRate >= 0 ? "+" : "")
                    @ViewBag.ChangeRate %
                </span>

            </div>

           
            <div class="mt-3">
                <h1 class="mb-0 fw-bold text-danger">
                    @ViewBag.TotalOrders
                </h1>
                <small class="text-muted">Toplam yeni sipariş</small>
            </div>
        </div>

        <div id="sparklineOrder"></div>
    </div>


<script>
    var sparklineData = @Html.Raw(
                System.Text.Json.JsonSerializer.Serialize(ViewBag.SparklineData)
        );
</script>

<script>
    if (sparklineData && sparklineData.length > 0) {

            var options = {
                chart: {
                    type: 'area',
                    height: 80,
                    sparkline: { enabled: true }
                },
                series: [{
                    data: sparklineData
                }],
                stroke: {
                    curve: 'straight',
                    width: 2
                },
                fill: {
                    opacity: 0.15
                },
                colors: ['#30CF30']
            };


        var chart = new ApexCharts(
            document.querySelector("#sparklineOrder"),
            options
        );

        chart.render();
    }
</script>
