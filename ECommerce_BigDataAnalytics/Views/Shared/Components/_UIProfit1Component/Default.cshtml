@using ECommerce_BigDataAnalytics.Dtos.ProfitDto
@model ProfitDto
<div class="card shadow-sm border-0 rounded-3 h-100">
    <div class="card-body text-center d-flex flex-column">

        <h5 class="fw-bold text-primary mb-3">
            💰 Kar Marjı
        </h5>

        <div class="d-flex justify-content-center mb-3">

            <div class="position-relative">

                <canvas id="profitChart" width="220" height="220"></canvas>

                <div class="position-absolute top-50 start-50 translate-middle text-center">

                    <h2 class="fw-bold text-success mb-0">
                        @ViewBag.Profit1%
                    </h2>

                    <small class="text-muted">Profit</small>

                </div>

            </div>

        </div>

        <div class="mt-auto text-center">

            <div class="fw-bold text-dark mb-2">
                📅 Aralık 2025 Kar Analizi
            </div>

            <div class="d-flex justify-content-center gap-4 mt-3">

                <div>
                    <div class="text-muted small">
                        💳 Gelir
                    </div>
                    <div class="fw-bold text-secondary fs-5">
                        @Model.Revenue.ToString("N0")
                    </div>
                </div>

                <div>
                    <div class="text-muted small">
                        💵 Kar
                    </div>
                    <div class="fw-bold text-success fs-5">
                        @Model.EstimatedProfit.ToString("N0")
                    </div>
                </div>

            </div>

        </div>

    </div>
</div>

@* <script src="https://cdn.jsdelivr.net/npm/chart.js"></script> *@

<script>

    document.addEventListener("DOMContentLoaded", function () {

        var profitPercentage = parseFloat("@(ViewBag.Profit1 ?? 0)".replace(",", "."));

        var ctx = document.getElementById("profitChart").getContext("2d");

        new Chart(ctx, {

            type: "doughnut",

            data: {

                datasets: [{
                    data: [profitPercentage, 100 - profitPercentage],
                    backgroundColor: ["#216E58", "#A8E3E0"],
                    borderWidth: 0
                }]

            },

            options: {

                responsive: false,

                cutout: "70%",

                plugins: {

                    legend: {
                        display: false
                    },

                    tooltip: {
                        enabled: true
                    }

                }

            }

        });

    });
</script>