<div class="card h-100 shadow-sm border-0 text-dark"
     style="background: linear-gradient(135deg, #f5e6d3, #e6c7a1);">
    
    <div class="card-body d-flex align-items-center justify-content-between">

        <div>
            <h6 class="text-muted mb-1">Sipariş Sayısı</h6>
            <h2 class="fw-bold mb-0">
                @ViewBag.TotalOrders
            </h2>
            <small class="text-muted">Toplam sipariş sayısı</small>
        </div>

        <div class="icon-circle bg-white text-warning">
            <i class="bi bi-receipt" style="font-size: 34px;"></i>
        </div>

    </div>
</div>

<style>


    .icon-circle {
        width: 65px;
        height: 65px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
    }
</style>