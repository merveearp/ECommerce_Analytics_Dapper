@model List<MonthlyOrderStatusCountDto>

<div class="col-xl-6 col-lg-6 col-md-6 col-sm-12 col-12">
    <div class="card">
        <h5 class="card-header">Aylık Sipariş Süreci </h5>
        <div class="card-body" style="height:360px;">
            <canvas id="lineChart1"></canvas>
        </div>
    </div>
</div>

@{
    var months = Model
        .OrderBy(x => x.MonthNumber)
        .Select(x => x.MonthName)
        .Distinct()
        .ToList();

    var grouped = Model.GroupBy(x => x.OrderStatusName);
}

<script>
    function getColor(status) {
        switch (status) {
            case 'Beklemede': return '#1E88E5';       
            case 'Onaylandi': return '#F4511E';       
            case 'Iptal Edildi': return '#C62828';    
            case 'Kargoya Verildi': return '#8E24AA'; 
            case 'Teslim Edildi': return '#2E7D32';   
            default: return '#546E7A';
        }
    }

    function getDatasetType(status) {
        switch (status) {
            case 'Kargoya Verildi':
            case 'Teslim Edildi':
                return 'line';
            default:
                return 'bar';
        }
    }

    const chartData = {
        labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(months)),
        datasets: [
            @foreach (var group in grouped)
            {
                    var data = months.Select(month =>
                            group.FirstOrDefault(x => x.MonthName == month)?.OrderCount ?? 0
                    ).ToList();

                    <text>
                    {
                        type: getDatasetType('@group.Key'),
                        label: '@group.Key',
                        data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(data)),

                        backgroundColor:
                            getDatasetType('@group.Key') === 'bar'
                                ? getColor('@group.Key')
                                : 'transparent',

                        borderColor: getColor('@group.Key'),
                        borderWidth: getDatasetType('@group.Key') === 'line' ? 3 : 1,

                        tension: 0.35,
                        fill: false,
                        pointRadius: getDatasetType('@group.Key') === 'line' ? 4 : 0,
                        pointHoverRadius: 6
                    },
                    </text>
            }
        ]
    };

    new Chart(document.getElementById('lineChart1'), {
        type: 'bar',
        data: chartData,
        options: {
            responsive: true,
            maintainAspectRatio: false,
            scales: {
                y: {
                    beginAtZero: true
                }
            },
            plugins: {
                legend: {
                    position: 'bottom'
                },
                tooltip: {
                    callbacks: {
                        label: function (context) {
                            return context.dataset.label + ': ' + context.raw + ' sipariş';
                        }
                    }
                }
            }
        }
    });
</script>
