@model List<PolarChartOrderStatusDto>

<div class="col-xl-6 col-lg-6 col-md-6 col-sm-12 col-12">
    <div class="card h-100">
        <h5 class="card-header">Sipariş Durum & Sipariş Sayısı</h5>
        <div class="card-body d-flex justify-content-center align-items-center">
            <canvas id="orderPolarChart" style="max-height:300px;"></canvas>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {

        const ctx = document.getElementById('orderPolarChart');
        if (!ctx) return;

           const labels = [
            @foreach (var item in Model)
            {
                    <text>'@Html.Raw(item.StatusName)',</text>
            }
            ];


        const data = [
            @foreach (var item in Model)
            {
                    <text>@item.OrderCount,</text>
            }
        ];

           const colors = [
            '#64B5F6', 
            '#BA68C8', 
            '#81C784', 
            '#E57373',    
            '#FFB74D'
        ];


        new Chart(ctx, {
            type: 'doughnut',
            data: {
                labels: labels,
                datasets: [{
                    data: data,
                    backgroundColor: colors.slice(0, data.length),
                    borderColor: '#fff',
                    borderWidth: 2
                }]
            }
        });

    });
</script>
