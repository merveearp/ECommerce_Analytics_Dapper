<div class="card h-100 shadow-sm border-0 text-white" style="background: linear-gradient(135deg, #2563eb, #1e40af);">
    <div class="card-body d-flex align-items-center justify-content-between">

        <div>
            <h6 class="text-white-50 mb-1">Müşteri Değerleri</h6>
            <h2 class="fw-bold mb-0">
                @ViewBag.TotalCustomers
            </h2>
            <small class="text-white-50">Toplam müşteri sayısı</small>
        </div>

        <div class="icon-circle bg-white text-primary">
            <i class="bi bi-person-circle" style="font-size: 32px;"></i>
        </div>

    </div>
</div>

<style>

    .icon-circle {
        width: 65px;
        height: 65px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
    }
</style>