
@*
    _UIWidget1Component
*@

<style>


    .icon-circle {
        width: 44px;
        height: 44px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
    }

    .badge-success {
        background-color: #d1fae5;
        color: #065f46;
    }

    .badge-danger {
        background-color: #fee2e2;
        color: #991b1b;
    }

</style>
<!-- metric -->
<div class="col-xl-3 col-lg-6 col-md-6 col-sm-12 col-12">
    <div class="card">
        <div class="card-body">
            <div class="d-flex align-items-center justify-content-between">

               
                <div class="d-flex align-items-center">
                    <div>
                        <h6 class="text-muted mb-0">Müşteri Değerleri</h6>
                        <small class="text-muted">Son 7 Gün</small>
                    </div>
                </div>

                
                <span class="badge
            @(ViewBag.ChangeRate >= 0 ? "badge-success" : "badge-danger")
            fs-6">
                    <i class="fa @(ViewBag.ChangeRate >= 0 ? "fa-arrow-up" : "fa-arrow-down")"></i>
                    @(ViewBag.ChangeRate >= 0 ? "+" : "")
                    @ViewBag.ChangeRate %
                </span>

            </div>

           
            <div class="mt-3">
                <h1 class="mb-0 fw-bold text-primary">
                    @ViewBag.TotalCustomers
                </h1>
                <small class="text-muted">Toplam yeni müşteri</small>
            </div>
        </div>

        <div id="sparklineCustomer"></div>
    </div>
</div>


<script>
    var sparklineData = @Html.Raw(
                System.Text.Json.JsonSerializer.Serialize(ViewBag.SparklineData)
        );
</script>

<script>
    if (sparklineData && sparklineData.length > 0) {

            var options = {
                chart: {
                    type: 'area',
                    height: 80,
                    sparkline: { enabled: true }
                },
                series: [{
                    data: sparklineData
                }],
                stroke: {
                    curve: 'straight',
                    width: 2
                },
                fill: {
                    opacity: 0.15
                },
                colors: ['#6366f1']
            };


        var chart = new ApexCharts(
            document.querySelector("#sparklineCustomer"),
            options
        );

        chart.render();
    }
</script>
