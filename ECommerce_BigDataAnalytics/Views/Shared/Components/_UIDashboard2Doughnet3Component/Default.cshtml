@using ECommerce_BigDataAnalytics.Dtos.CountryDto
@model List<CountryAreaTotalAmountDto>


    
<div class="card h-100">
    <h5 class="card-header">Ülke Durum & Ciro </h5>
    <div class="card-body d-flex justify-content-center align-items-center">
        <canvas id="doughnut3" style="max-height:300px;"></canvas>
    </div>
</div>

@using System.Text.Json
<script>

    document.addEventListener("DOMContentLoaded", function () {

        const data = @Html.Raw(JsonSerializer.Serialize(Model));

        const labels = data.map(x => x.CountryName);
        const values = data.map(x => x.TotalAmount);

        const ctx = document.getElementById('doughnut3');

        if (!ctx) return;

        new Chart(ctx, {
            type: 'doughnut',
            data: {
                labels: labels,
                datasets: [{
                    data: values,
                    hoverOffset: 10,

                           backgroundColor: [
                    '#16A34A', 
                    '#22C55E', 
                    '#4ADE80', 
                    '#86EFAC',

                    '#F59E0B', 
                    '#FBBF24', 

                    '#2563EB', 
                    '#3B82F6',

                    '#8B5CF6', 
                    '#14B8A6' 
                ],

                    borderColor: '#fff',
                    borderWidth: 2
                }]
            },
            options: {
                cutout: '55%',
                responsive: true,
                maintainAspectRatio: false,

                plugins: {
                    legend: {
                        position: 'right',
                        labels: {
                            usePointStyle: true,
                            pointStyle: 'circle',
                            padding: 16,
                            font: {
                                size: 13
                            }
                        }
                    },

                    tooltip: {
                        backgroundColor: '#0f172a',
                        titleColor: '#fff',
                        bodyColor: '#e5e7eb',
                        padding: 10,
                        cornerRadius: 8,
                        callbacks: {
                                label: function (context) {
                            return `${context.label}: $ ${context.raw.toLocaleString()}`;
                        }
                        }
                    }
                }
            }
        });

    });

</script>